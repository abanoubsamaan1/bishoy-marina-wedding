{
  // Cloudflare Workers Static Assets deployment.
  //
  // This project stays a plain Vite build — there is no Worker source code and
  // no `main` entry point. Workers Static Assets only needs to know where the
  // build output is and how to handle a request that does not match a file.
  //
  // The publish directory is the CONTENTS of `dist`, so the deployed site root
  // contains index.html, images/ and audio/ — which is what the root-relative
  // asset URLs (/images/..., /audio/...) in the bundle expect. This mirrors the
  // publish directory already configured in netlify.toml.
  //
  //   build:    npm run build   (unchanged, still Vite)
  //   deploy:   npx wrangler deploy
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bishoy-marina-wedding",
  "compatibility_date": "2026-10-05",
  "assets": {
    "directory": "./dist",
    // Single-page app: unknown paths are served index.html so client-side
    // routing resolves instead of returning a 404.
    "not_found_handling": "single-page-application"
  }
}