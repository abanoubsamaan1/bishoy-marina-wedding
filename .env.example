# Shared database for the guest messages section.
# Copy this file to `.env` (or `.env.local`) and fill in the values from
# Supabase -> Project Settings -> API.
#
# Use the PUBLIC / anon key only. Never put the service_role key in a VITE_
# variable: everything prefixed with VITE_ is shipped to the browser.
#
# The anon key is safe to publish because row level security on
# `guest_messages` only allows anonymous SELECT and INSERT.
#
# Then run supabase/migrations/0001_guest_messages.sql once in the project.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
